"w5500\stm32f1xx_hal.o"
"w5500\stm32f1xx_hal_rcc.o"
"w5500\stm32f1xx_hal_rcc_ex.o"
"w5500\stm32f1xx_hal_gpio.o"
"w5500\stm32f1xx_hal_dma.o"
"w5500\stm32f1xx_hal_cortex.o"
"w5500\stm32f1xx_hal_pwr.o"
